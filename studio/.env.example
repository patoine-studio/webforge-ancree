# Studio Sanity, démo WebForge Ancrée.
# Les valeurs par défaut (fallback dans sanity.config.ts et sanity.cli.ts)
# couvrent le dev local: ce fichier sert surtout de référence.

# Project « WebForge - Ancrée » (5if00rwn), org Patoine Studio.
SANITY_STUDIO_PROJECT_ID=5if00rwn
SANITY_STUDIO_DATASET=production

# Origine optionnelle du site pour l'iframe du Presentation tool.
# Le dev local retombe sur le port 3000. Un build ou un deploiement retombe sur
# le Worker preview public et n'embarque jamais une origine localhost.
# Decommenter seulement pour viser un autre environnement en developpement.
SANITY_STUDIO_PREVIEW_URL=http://localhost:3000
